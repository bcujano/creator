# Supabase (proyecto propio de CREATOR) → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# La "Publishable key" (sb_publishable_…) o la anon key antigua
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# La "Secret key" (sb_secret_…) o la service_role antigua. Nunca se comparte.
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Session pooler → URI, con tu contraseña en lugar de [YOUR-PASSWORD]. Solo para `pnpm db:migrate`
SUPABASE_DB_URL=

# Quién puede entrar (correos separados por coma)
ADMIN_EMAILS=

# IA: Anthropic es el motor principal; OpenAI es respaldo y transcribe audio
# Solo si tu llave no pertenece a un workspace: Console → Settings → Workspaces → ID (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Integración con el CRM (crm-321: POST /api/webhook)
CRM_WEBHOOK_URL=https://crm.321archlab.com/api/webhook
CRM_WEBHOOK_SECRET=

# URL pública de CREATOR (enlaces para el cliente)
NEXT_PUBLIC_APP_URL=http://localhost:3000
